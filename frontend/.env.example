# Copy to frontend/.env to change these. Vite only exposes variables that
# start with VITE_ to the browser, and bakes them in at build time, so never
# put a secret here.

# Where the FastAPI backend lives. Adding ?api=http://host:port to the page
# URL overrides this for one browser tab.
VITE_API_BASE=http://localhost:8000

# How long the browser waits for an upload before giving up, in milliseconds.
# Keep it a little above the backend's CORA_REQUEST_TIMEOUT_SECONDS.
VITE_UPLOAD_TIMEOUT_MS=130000
