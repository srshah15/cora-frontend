# Copy to backend/.env and fill in the values you need. Never commit .env.
# Every variable is optional: with none set, CORA runs keyword extraction only.

# Which extractor builds the plan: "keyword" (default; no key, no network)
# or "claude" (LLM extraction; requires ANTHROPIC_API_KEY).
CORA_EXTRACTOR=keyword

# Claude API key for LLM extraction. Required when CORA_EXTRACTOR=claude.
ANTHROPIC_API_KEY=

# Claude model used for LLM extraction.
CORA_LLM_MODEL=claude-opus-5-5

# How long to wait for one LLM response, in seconds.
CORA_LLM_TIMEOUT_SECONDS=50

# How hard the model thinks: low, medium, high, xhigh or max.
# Higher is slower and costs more.
CORA_LLM_EFFORT=medium

# Protocols with more pages than this are rejected with a clear message.
CORA_MAX_PAGES=150

# Upper limit for one upload, end to end, in seconds.
CORA_REQUEST_TIMEOUT_SECONDS=120

# Most scanned pages CORA will read by OCR in one upload.
CORA_MAX_OCR_PAGES=50

# Extra browser origins allowed to call the API, comma-separated
# (the deployed frontend's URL). Local dev origins are always allowed.
CORS_ORIGINS=

# PostgreSQL connection string from Supabase.
# postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=
