# Copy to backend/.env and fill in the required environment variables. Never commit .env.
# Real environment variables take precedence over this file.

# Which extractor the upload endpoint uses:
#   keyword - rule-based, no API key required (default)
#   llm - LLM API extraction, requires LLM_API_KEY
EXTRACTOR=keyword

# LLM API key for LLM extraction.
LLM_API_KEY=

# LLM model, request timeout in seconds, and retries on transient errors.
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT=60
LLM_RETRIES=2

# PostgreSQL connection string from Supabase.
# postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=